NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=forgeflow
JWT_SECRET=replace_this_with_a_long_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# AI provider priority. Unconfigured providers are skipped automatically.
AI_PROVIDER_ORDER=openrouter,gemini,groq,mistral,deepseek,openai
AI_PROVIDER_TIMEOUT_MS=30000
AI_PROVIDER_COOLDOWN_MS=60000

# OpenRouter. The openrouter/free model alias selects from currently available free models.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=ForgeFlow

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Mistral
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# DeepSeek (paid API usage; optional fallback)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI or another OpenAI-compatible endpoint (legacy AI_API_KEY remains supported)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# TinyFish web search, page fetch and browser agent
TINYFISH_API_KEY=
